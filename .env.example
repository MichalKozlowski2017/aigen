# Adres ComfyUI — lokalnie lub URL tunelu (Vercel → Legion)
COMFYUI_URL=http://127.0.0.1:8188

# === Tylko panel lokalny (ta sama maszyna co Comfy) ===
# Na Vercel NIE ustawiaj — Modele/Galeria idą przez COMFYUI_URL (API /models, /history).
# Katalog modeli ComfyUI (checkpoints, diffusion_models, text_encoders, vae, …)
# Windows np.: C:\ComfyUI\models
# COMFYUI_MODELS_DIR=

# Katalog outputów ComfyUI (opcjonalny lokalny skan galerii)
# Windows np.: C:\ComfyUI\output
# COMFYUI_OUTPUT_DIR=

# === Vercel / produkcja ===
# Wystarczy COMFYUI_URL (+ STUDIO_PASSWORD). Status modeli: GET /models/{folder}.
# Galeria: indeks aigen-gallery-index.json (pierwszeństwo) + /history + /api/comfy-view.
#
# Tunel Cloudflare (Legion):
# - Named Tunnel (zalecane, stały URL) — ustaw raz, np.:
#   COMFYUI_URL=https://comfy.your-domain.com
#   Instrukcja: docs/named-cloudflare-tunnel.md
# - Quick Tunnel (*.trycloudflare.com) — hostname ZMIENIA SIĘ po restarcie cloudflared;
#   po każdym reboocie skopiuj URL z logs/cloudflared-tunnel-url.txt → Vercel → redeploy.
#   Autostart Quick: scripts/legion/start-comfy-stack.ps1

# Opcjonalne hasło do panelu i /api/* (puste = otwarte lokalnie)
# STUDIO_PASSWORD=

# Pipeline chunków — zostaw WYŁĄCZONE (domyślnie).
# PIPELINE_LEGION_WORKER=1 to eksperymentalny tryb (panel GET bez advance;
# register nie ma osobnego auth). Nie włączaj jako „required”.
# Niezależny aigen-queue-worker.py na Legionie (jeśli jest) NIE wymaga tej flagi.
# Domyślnie: awaited after() + GET advance + durable JSON w Comfy input.
# PIPELINE_LEGION_WORKER=1

# Opcjonalny checkpoint SDXL (opcja w dropdownie Obraz)
# STUDIO_DEFAULT_CHECKPOINT=sd_xl_base_1.0.safetensors

# Domyślny silnik obrazu: flux (domyślnie) | sdxl | nazwa pliku
# STUDIO_DEFAULT_IMAGE_MODEL=flux

# Flux.2 Dev fp8 — nazwy z flux-setup.md (Legion / Comfy-Org/flux2-dev)
# STUDIO_FLUX_UNET=flux2_dev_fp8mixed.safetensors
# STUDIO_FLUX_CLIP=mistral_3_small_flux2_fp8.safetensors
# STUDIO_FLUX_VAE=flux2-vae.safetensors
# STUDIO_FLUX_WEIGHT_DTYPE=default

# Prompt boost (PL→EN) — domyślnie MyMemory (bez klucza)
# MYMEMORY_EMAIL=you@example.com
# PROMPT_BOOST_ALWAYS_TRANSLATE=1
# LIBRETRANSLATE_URL=http://127.0.0.1:5000
# LIBRETRANSLATE_API_KEY=
# OPENAI_API_KEY=
# OPENAI_PROMPT_MODEL=gpt-4o-mini
